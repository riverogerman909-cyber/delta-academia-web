{
  // Configuración para publicar el sitio estático de Delta Academia en Cloudflare.
  "name": "delta-academia-web",
  "compatibility_date": "2024-11-01",
  // Sirve la carpeta generada por Astro (`npm run build`) como archivos estáticos.
  "assets": {
    "directory": "./dist",
    // Ante una URL inexistente, sirve la página 404 propia en vez de una respuesta en blanco.
    "not_found_handling": "404-page"
  }
}
