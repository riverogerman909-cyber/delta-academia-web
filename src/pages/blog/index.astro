---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fecha = (d) =>
  d.toLocaleDateString('es-UY', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Blog — Delta Academia" description="Artículos y guías de estudio para las materias de FCEA, escritos por Delta Academia.">
  <section class="encabezado-pagina">
    <div class="contenedor reveal">
      <span class="kicker">Blog</span>
      <h1>Ideas claras para estudiar mejor</h1>
      <p class="medida">
        Artículos cortos y sin vueltas sobre contabilidad, derecho y método de estudio,
        pensados para estudiantes de FCEA.
      </p>
    </div>
  </section>

  <section class="seccion" style="padding-top: var(--sp-6);">
    <div class="contenedor">
      <div class="grid">
        {posts.map((p) => (
          <a href={`/blog/${p.id}`} class="card post reveal">
            <span class="chip chip-ambar">{p.data.tag}</span>
            <h3>{p.data.title}</h3>
            <p class="post-desc">{p.data.description}</p>
            <div class="post-meta">
              <span class="post-autor">{p.data.author}</span>
              <span>·</span>
              <time datetime={p.data.date.toISOString()}>{fecha(p.data.date)}</time>
            </div>
            <span class="post-mas">Leer artículo →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .encabezado-pagina { padding: var(--sp-8) 0 var(--sp-2); background: linear-gradient(180deg, var(--azul-claro) 0%, var(--fondo) 100%); }
  .post { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; text-decoration: none; }
  .post-desc { color: var(--texto-suave); font-size: 0.95rem; flex-grow: 1; margin: 0; }
  .post-meta { display: flex; gap: 8px; font-size: 0.83rem; color: var(--texto-suave); }
  .post-autor { font-weight: 700; color: var(--azul); }
  .post-mas { color: var(--azul); font-weight: 700; font-size: 0.9rem; }
  .post:hover .post-mas { color: var(--ambar); }
</style>
