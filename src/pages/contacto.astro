---
import Base from '../layouts/Base.astro';
import { materias } from '../data/materias.js';
---

<Base title="Contacto — Delta Academia | Cursos de FCEA" description="Escribinos por WhatsApp o email para conocer días, horarios y modalidad de los cursos de FCEA (UdelaR): contabilidad, cálculo y derecho.">
  <section class="encabezado-pagina">
    <div class="contenedor reveal">
      <span class="kicker">Contacto</span>
      <h1>Hablemos</h1>
      <p class="medida">
        Contanos qué materia te interesa y te respondemos con días, horarios y modalidad.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor cols">
      <div class="reveal">
        <form id="form-contacto" class="card" novalidate>
          <div class="campo">
            <label for="nombre">Nombre</label>
            <input id="nombre" name="nombre" type="text" required placeholder="Tu nombre" />
            <span class="error" data-para="nombre"></span>
          </div>
          <div class="campo">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required placeholder="tucorreo@ejemplo.com" />
            <span class="error" data-para="email"></span>
          </div>
          <div class="campo">
            <label for="materia">Materia de interés</label>
            <select id="materia" name="materia">
              <option value="">Elegí una opción…</option>
              {materias.map((m) => <option>{m.nombre}</option>)}
              <option>Otra / no sé todavía</option>
            </select>
          </div>
          <div class="campo">
            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="4" placeholder="Contanos en qué te podemos ayudar"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
            Enviar por WhatsApp
          </button>
          <p class="exito" id="exito" hidden>¡Listo! Se abrió WhatsApp con tu mensaje. Solo apretá enviar y te respondemos a la brevedad.</p>
        </form>
      </div>

      <aside class="reveal">
        <div class="card contacto-directo">
          <h3>Contacto directo</h3>
          <p style="color: var(--texto-suave);">Si preferís, escribinos por acá:</p>
          <ul>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
              <a href="https://wa.me/59898521288" target="_blank" rel="noopener">WhatsApp +598 98 521 288</a>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
              <a href="mailto:academiadelta5@gmail.com">academiadelta5@gmail.com</a>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg>
              <a href="https://instagram.com/delta.academiagr" target="_blank" rel="noopener">@delta.academiagr</a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <script>
    const form = document.getElementById('form-contacto');
    const exito = document.getElementById('exito');

    function setError(campo, msg) {
      const input = form.querySelector(`[name="${campo}"]`);
      const span = form.querySelector(`.error[data-para="${campo}"]`);
      if (span) span.textContent = msg;
      if (input) input.classList.toggle('invalido', Boolean(msg));
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      let ok = true;
      const nombre = form.nombre.value.trim();
      const email = form.email.value.trim();

      if (!nombre) { setError('nombre', 'Ingresá tu nombre.'); ok = false; } else setError('nombre', '');
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!emailOk) { setError('email', 'Ingresá un email válido.'); ok = false; } else setError('email', '');

      if (ok) {
        // Arma el mensaje y abre WhatsApp hacia el número de Delta Academia.
        const materia = form.materia.value || 'No especificada';
        const mensaje = form.mensaje.value.trim() || '(sin mensaje)';
        const texto =
          `¡Hola Delta Academia! Soy ${nombre}.\n` +
          `Materia de interés: ${materia}\n` +
          `Mensaje: ${mensaje}\n` +
          `Mi email: ${email}`;
        const url = `https://wa.me/59898521288?text=${encodeURIComponent(texto)}`;
        window.open(url, '_blank');
        exito.hidden = false;
        form.reset();
      }
    });
  </script>
</Base>

<style>
  .encabezado-pagina { padding: var(--sp-8) 0 var(--sp-2); background: linear-gradient(180deg, var(--azul-claro) 0%, var(--fondo) 100%); }
  .cols { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: var(--sp-4); align-items: start; }
  .campo { margin-bottom: var(--sp-2); }
  label { display: block; font-weight: 500; font-size: 0.9rem; margin-bottom: 6px; }
  input, select, textarea {
    width: 100%; padding: 12px 14px; font-family: var(--fuente-texto); font-size: 1rem;
    border: 1px solid var(--borde); border-radius: var(--radio); background: var(--fondo);
    transition: border-color var(--trans), box-shadow var(--trans);
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--azul); box-shadow: 0 0 0 3px rgba(29,58,110,0.12); }
  input.invalido { border-color: #dc2626; }
  .error { color: #dc2626; font-size: 0.82rem; display: block; margin-top: 4px; min-height: 1em; }
  .exito { color: #047857; font-weight: 500; margin-top: var(--sp-2); text-align: center; }
  .contacto-directo ul { list-style: none; padding: 0; margin: var(--sp-2) 0 0; }
  .contacto-directo li { padding: 8px 0; display: flex; align-items: center; gap: 10px; }
  .contacto-directo svg { flex-shrink: 0; color: var(--azul); }
  @media (max-width: 780px) { .cols { grid-template-columns: 1fr; } }
</style>
