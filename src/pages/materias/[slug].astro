---
import Base from '../../layouts/Base.astro';
import { materias } from '../../data/materias.js';
import { recursosDe } from '../../data/recursos.js';

export function getStaticPaths() {
  return materias.map((m) => ({ params: { slug: m.slug }, props: { materia: m } }));
}

const { materia } = Astro.props;
const recursos = recursosDe(materia.slug);

const seoTitle = `Curso de ${materia.nombre} (${materia.codigo}) — FCEA | Delta Academia`;
const seoDesc = `Curso online de ${materia.nombre} para estudiantes de FCEA (UdelaR): material grabado, clases semanales por Zoom y práctica tipo parcial. ${materia.resumen}`;

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${materia.nombre} (FCEA — UdelaR)`,
  courseCode: materia.codigo,
  description: seoDesc,
  provider: {
    '@type': 'EducationalOrganization',
    name: 'Delta Academia',
    url: 'https://deltaacademiagr.com',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    instructor: (materia.docentes || []).map((d) => ({ '@type': 'Person', name: d })),
  },
  offers: {
    '@type': 'Offer',
    category: 'Paid',
    availability: 'https://schema.org/InStock',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://deltaacademiagr.com/' },
    { '@type': 'ListItem', position: 2, name: 'Materias', item: 'https://deltaacademiagr.com/materias' },
    { '@type': 'ListItem', position: 3, name: materia.nombre, item: `https://deltaacademiagr.com/materias/${materia.slug}` },
  ],
};
---

<Base title={seoTitle} description={seoDesc} schema={[courseSchema, breadcrumbSchema]}>
  <section class="encabezado-materia">
    <div class="contenedor reveal">
      <a href="/materias" class="volver">← Todas las materias</a>
      <div class="chips">
        <span class="chip">{materia.codigo}</span>
        <span class="chip chip-ambar">{materia.semestre}</span>
        <span class="chip">{materia.area}</span>
      </div>
      <h1>{materia.nombre}</h1>
      <p class="medida">{materia.resumen}</p>
      <a href="/contacto" class="btn btn-ambar mt-3">Sumarme a esta materia</a>
    </div>
  </section>

  <section class="seccion" style="padding-top: var(--sp-6);">
    <div class="contenedor cols">
      <div class="col-principal">
        <div class="reveal">
          <h2>Objetivo del curso</h2>
          <p>{materia.objetivo}</p>
        </div>

        <div class="reveal" style="margin-top: var(--sp-6);">
          <h2>Programa</h2>
          <ol class="temario">
            {materia.temario.map((t) => <li>{t}</li>)}
          </ol>
        </div>

        {recursos.length > 0 && (
          <div class="reveal" style="margin-top: var(--sp-6);">
            <h2>Material gratuito</h2>
            <p style="color: var(--texto-suave);">Practicá con preguntas de exámenes reales de la FCEA. Sin registro.</p>
            <div class="recursos-lista">
              {recursos.map((r) => (
                <div class="recurso-item">
                  <div>
                    <span class="chip chip-ambar">{r.tipo}</span>
                    <h3 style="margin: 8px 0 4px;">{r.titulo}</h3>
                    <p style="margin: 0; color: var(--texto-suave); font-size: 0.95rem;">{r.descripcion}</p>
                  </div>
                  <div class="grupo-btn">
                    {r.interactivo && <a href={r.interactivo} class="btn btn-primary">Resolver online</a>}
                    {r.pdf && <a href={r.pdf} class="btn btn-secondary" download>PDF</a>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <aside class="col-lateral reveal">
        <div class="ficha">
          <h3>Ficha rápida</h3>
          <dl>
            <dt>Código</dt><dd>{materia.codigo}</dd>
            <dt>Semestre</dt><dd>{materia.semestre}</dd>
            <dt>Área</dt><dd>{materia.area}</dd>
            <dt>Previa</dt><dd>{materia.previa}</dd>
            {materia.docentes && <><dt>Docentes</dt><dd>{materia.docentes.join(' · ')}</dd></>}
            {materia.horario && <><dt>Clases en vivo (Zoom)</dt><dd>{materia.horario}</dd></>}
          </dl>
          <div class="ficha-carreras">
            <span class="ficha-label">Obligatoria en</span>
            <div class="carreras">
              {materia.carreras.map((c) => <span class="chip-carrera">{c}</span>)}
            </div>
          </div>
          <div class="ficha-eval">
            <strong>Evaluación</strong>
            <p>{materia.evaluacion}</p>
          </div>
          <a href="/contacto" class="btn btn-primary" style="width:100%; justify-content:center;">Consultar horarios</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .encabezado-materia { padding: var(--sp-8) 0 var(--sp-4); background: linear-gradient(180deg, var(--azul-claro) 0%, var(--fondo) 100%); }
  .volver { font-weight: 500; font-size: 0.9rem; display: inline-block; margin-bottom: var(--sp-2); }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: var(--sp-2); }

  .cols { display: grid; grid-template-columns: 1fr 340px; gap: var(--sp-6); align-items: start; }
  .temario { padding-left: 0; list-style: none; counter-reset: t; }
  .temario li {
    counter-increment: t; position: relative; padding: 14px 0 14px 48px;
    border-bottom: 1px solid var(--borde);
  }
  .temario li::before {
    content: counter(t); position: absolute; left: 0; top: 12px;
    width: 30px; height: 30px; border-radius: 8px;
    background: var(--azul-claro); color: var(--azul);
    font-weight: 700; font-size: 0.9rem;
    display: flex; align-items: center; justify-content: center;
  }

  .recursos-lista { display: flex; flex-direction: column; gap: var(--sp-2); }
  .recurso-item { background: var(--azul-claro); border-radius: var(--radio-card); padding: var(--sp-3); display: flex; flex-direction: column; gap: var(--sp-2); }
  .ficha { background: var(--blanco); border: 1px solid var(--borde); border-radius: var(--radio-card); padding: var(--sp-3); box-shadow: var(--sombra-1); position: sticky; top: 90px; }
  .ficha h3 { margin-top: 0; }
  .ficha dl { display: grid; grid-template-columns: 1fr; gap: 2px; margin: 0 0 var(--sp-2); }
  .ficha dt { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--texto-suave); margin-top: 12px; }
  .ficha dd { margin: 0; font-weight: 500; }
  .ficha-eval { background: var(--fondo); border-radius: var(--radio); padding: var(--sp-2); margin-bottom: var(--sp-3); }
  .ficha-eval strong { color: var(--azul); }
  .ficha-eval p { margin: 6px 0 0; font-size: 0.9rem; color: var(--texto-suave); }
  .ficha-carreras { margin-bottom: var(--sp-3); }
  .ficha-label { display: block; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--texto-suave); margin-bottom: 8px; }

  @media (max-width: 860px) {
    .cols { grid-template-columns: 1fr; }
    .ficha { position: static; }
  }
</style>
