---
import { novedades, WHATSAPP } from '../data/novedades.js';
import { recursos } from '../data/recursos.js';

const wa = (texto) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(texto)}`;
const ahora = Date.now();

const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
const DIAS_CORTOS = ['DOM', 'LUN', 'MAR', 'MIÉ', 'JUE', 'VIE', 'SÁB'];
const MESES_CORTOS = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SET', 'OCT', 'NOV', 'DIC'];
// Las fechas se interpretan en hora de Uruguay sin depender de la zona horaria del build.
const partes = (iso) => {
  const d = new Date(Date.parse(iso.length === 10 ? `${iso}T12:00:00-03:00` : iso) - 3 * 3600 * 1000);
  return { dia: d.getUTCDate(), mes: d.getUTCMonth() + 1, semana: d.getUTCDay() };
};

const ultimoRecurso = [...recursos].sort((a, b) => b.fecha.localeCompare(a.fecha))[0];

const tarjetas = novedades.map((n) => {
  if (n.tipo === 'clase') {
    const p = partes(n.inicio);
    const pasada = ahora > Date.parse(n.fin);
    return {
      ...n,
      pasada,
      diaCorto: DIAS_CORTOS[p.semana],
      diaNum: p.dia,
      mesCorto: MESES_CORTOS[p.mes - 1],
      fechaLarga: `${DIAS[p.semana]} ${p.dia}/${p.mes}`,
      href: wa(pasada ? n.mensajePasada : n.mensaje),
      hrefPasada: wa(n.mensajePasada),
    };
  }
  const p = partes(n.fecha);
  const etiqueta = `${DIAS[p.semana].slice(0, 3)} ${p.dia}/${p.mes}`;
  return {
    ...n,
    etiqueta,
    embed: n.video?.youtube
      ? `https://www.youtube-nocookie.com/embed/${n.video.youtube}?autoplay=1&rel=0`
      : n.video?.drive
        ? `https://drive.google.com/file/d/${n.video.drive}/preview`
        : null,
    href: wa(`¡Hola! Quiero la grabación de la clase abierta de ${n.materia} del ${etiqueta}.`),
  };
});
if (ultimoRecurso) tarjetas.push({ tipo: 'recurso', ...ultimoRecurso });

---

<section class="novedades" id="novedades" aria-roledescription="carrusel" aria-label="Novedades de Delta Academia">
  <div class="contenedor">
    <div class="nov-head reveal">
      <div>
        <span class="kicker">Novedades</span>
        <h2>Clases abiertas y gratuitas</h2>
        <p class="nov-sub">Conectate a las próximas y recuperá las que ya dimos.</p>
      </div>
      <div class="nov-controles" aria-hidden="false">
        <button class="nov-flecha" data-dir="-1" aria-label="Novedad anterior">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
        </button>
        <button class="nov-flecha" data-dir="1" aria-label="Novedad siguiente">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      </div>
    </div>

    <div class="nov-track" tabindex="0" aria-label="Deslizá para ver más novedades">
      {tarjetas.map((t, i) => (
        <article class={`nov-card nov-${t.tipo}`} role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${tarjetas.length}`}
          data-fin={t.tipo === 'clase' ? t.fin : undefined} data-href-pasada={t.tipo === 'clase' ? t.hrefPasada : undefined}>

          {t.tipo === 'clase' && (
            <div class="clase-inner">
              <div class="clase-top">
                <span class={`badge-vivo${t.pasada ? ' pasada' : ''}`} data-badge><span class="punto" aria-hidden="true"></span><span data-badge-texto>{t.pasada ? 'Ya se dio' : 'Próxima clase'}</span></span>
                <div class="fecha" aria-label={t.fechaLarga}>
                  <span class="fecha-dia">{t.diaCorto}</span>
                  <span class="fecha-num">{t.diaNum}</span>
                  <span class="fecha-mes">{t.mesCorto}</span>
                </div>
              </div>
              <h3>{t.titulo}</h3>
              <ul class="sesiones">
                {t.sesiones.map((s) => (
                  <li><span class="hora">{s.hora}</span><a href={`/materias/${s.slug}`}>{s.materia}</a></li>
                ))}
              </ul>
              <p class="clase-desc">{t.descripcion}</p>
              <p class="clase-docente">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Con la {t.docente}
              </p>
              <a class="btn btn-ambar clase-cta" href={t.href} target="_blank" rel="noopener" data-cta>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
                <span data-cta-texto>{t.pasada ? 'Pedí la grabación' : 'Quiero el link'}</span>
              </a>
            </div>
          )}

          {t.tipo === 'grabacion' && (
            <>
              {t.embed ? (
                <button class="poster" data-embed={t.embed} data-titulo={`Clase abierta de ${t.materia}`} aria-label={`Ver la grabación de ${t.materia}`}>
                  <span class="chip-poster">Grabación</span>
                  <span class="play" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.6-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z" /></svg></span>
                  <span class="poster-titulo">{t.materia}</span>
                  <span class="poster-meta">Clase abierta · {t.etiqueta} · {t.hora}</span>
                </button>
              ) : (
                <a class="poster" href={t.href} target="_blank" rel="noopener" aria-label={`Pedir la grabación de ${t.materia} por WhatsApp`}>
                  <span class="chip-poster">Grabación</span>
                  <span class="play" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.6-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z" /></svg></span>
                  <span class="poster-titulo">{t.materia}</span>
                  <span class="poster-meta">Clase abierta · {t.etiqueta} · {t.hora}</span>
                </a>
              )}
              <div class="card-body">
                <p class="card-docente">{t.docente}</p>
                <p class="card-desc">{t.descripcion}</p>
                <ul class="card-lista">
                  <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>La clase completa, grabada</li>
                  <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>Para cualquier estudiante de FCEA</li>
                  <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>Gratis, te la pasamos por WhatsApp</li>
                </ul>
                <div class="card-acciones">
                  {t.embed ? (
                    <button class="btn btn-primary btn-chico" data-embed={t.embed} data-titulo={`Clase abierta de ${t.materia}`}>Ver la clase</button>
                  ) : (
                    <a class="btn btn-primary btn-chico" href={t.href} target="_blank" rel="noopener">Pedí la grabación</a>
                  )}
                  <a class="link-materia" href={`/materias/${t.slug}`}>Ver el curso →</a>
                </div>
              </div>
            </>
          )}

          {t.tipo === 'recurso' && (
            <>
              <a class="poster poster-recurso" href={t.interactivo}>
                <span class="chip-poster chip-claro">Material gratuito</span>
                <span class="doc" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><polyline points="9 15 11 17 15 13" /></svg></span>
                <span class="poster-titulo">{t.titulo}</span>
                <span class="poster-meta">Resolvelo online o descargá el PDF</span>
              </a>
              <div class="card-body">
                <p class="card-docente">Nuevo en Recursos</p>
                <p class="card-desc">Preguntas de exámenes reales de la FCEA, con respuesta y explicación.</p>
                <ul class="card-lista">
                  <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>Resolvés online y ves la corrección al instante</li>
                  <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>También en PDF para imprimir</li>
                  <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>Sin registro</li>
                </ul>
                <div class="card-acciones">
                  <a class="btn btn-primary btn-chico" href={t.interactivo}>Resolver online</a>
                  <a class="link-materia" href="/recursos">Todos los recursos →</a>
                </div>
              </div>
            </>
          )}
        </article>
      ))}
    </div>

    <div class="nov-dots" role="tablist" aria-label="Elegí una novedad">
      {tarjetas.map((_, i) => (
        <button class="nov-dot" role="tab" aria-label={`Ir a la novedad ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'} data-i={i}></button>
      ))}
    </div>
  </div>

  <dialog class="nov-modal" aria-label="Grabación de la clase">
    <div class="modal-caja">
      <button class="modal-cerrar" aria-label="Cerrar">×</button>
      <div class="modal-video"><iframe title="Grabación de la clase" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
    </div>
  </dialog>
</section>

<style>
  .novedades { padding: var(--sp-8) 0 var(--sp-6); }
  .nov-head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--sp-3); margin-bottom: var(--sp-3); }
  .nov-head h2 { margin-bottom: 6px; }
  .nov-sub { color: var(--texto-suave); margin: 0; }
  .nov-controles { display: flex; gap: 10px; flex-shrink: 0; }
  .nov-flecha {
    width: 46px; height: 46px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--blanco); color: var(--azul); border: 1px solid var(--borde);
    box-shadow: var(--sombra-1); cursor: pointer; transition: all var(--trans);
  }
  .nov-flecha:hover:not(:disabled) { background: var(--azul); color: var(--blanco); border-color: var(--azul); }
  .nov-flecha:disabled { opacity: 0.35; cursor: default; }

  .nov-track {
    --gap: 24px;
    display: grid; grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * var(--gap)) / 3);
    gap: var(--gap);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    padding: 6px 4px 22px; margin: 0 -4px;
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .nov-track::-webkit-scrollbar { display: none; }
  .nov-track:focus-visible { outline: 2px solid var(--ambar); outline-offset: 4px; border-radius: 12px; }

  .nov-card {
    scroll-snap-align: start; position: relative;
    display: flex; flex-direction: column;
    border-radius: 18px; overflow: hidden;
    background: var(--blanco); border: 1px solid var(--borde); box-shadow: var(--sombra-1);
    transition: transform var(--trans), box-shadow var(--trans);
  }
  .nov-card:hover { transform: translateY(-4px); box-shadow: var(--sombra-2); }

  /* ---------- Próxima clase (destacada) ---------- */
  .nov-clase { background: linear-gradient(150deg, #1D3A6E 0%, #16305c 60%, #10254a 100%); border: none; color: #fff; }
  .nov-clase::after {
    content: 'Δ'; position: absolute; right: -18px; bottom: -70px;
    font-family: var(--fuente-titulo); font-weight: 700; font-size: 15rem; line-height: 1;
    color: #fff; opacity: 0.05; pointer-events: none;
  }
  .clase-inner { position: relative; z-index: 1; padding: var(--sp-3); display: flex; flex-direction: column; height: 100%; }
  .clase-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--sp-2); }
  .badge-vivo {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;
    color: var(--ambar); background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 5px 11px; border-radius: 999px;
  }
  .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--ambar); box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.6); animation: pulso 1.8s infinite; }
  .badge-vivo.pasada { color: #cbd5e1; background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.2); }
  .badge-vivo.pasada .punto { background: #cbd5e1; animation: none; }
  @keyframes pulso { 0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.6); } 70% { box-shadow: 0 0 0 8px rgba(245, 158, 11, 0); } 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); } }
  .fecha {
    display: flex; flex-direction: column; align-items: center; min-width: 62px;
    background: #fff; color: var(--azul); border-radius: 12px; padding: 6px 8px 7px; line-height: 1;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }
  .fecha-dia, .fecha-mes { font-size: 0.66rem; font-weight: 700; letter-spacing: 1.2px; }
  .fecha-dia { color: #b45309; }
  .fecha-num { font-family: var(--fuente-titulo); font-weight: 800; font-size: 1.9rem; margin: 3px 0 2px; }
  .nov-clase h3 { color: #fff; font-size: 1.55rem; margin-bottom: var(--sp-2); }
  .sesiones { list-style: none; padding: 0; margin: 0 0 var(--sp-2); display: flex; flex-direction: column; gap: 8px; }
  .sesiones li {
    display: flex; align-items: center; gap: 12px;
    background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px; padding: 9px 12px;
  }
  .hora { font-weight: 700; color: var(--ambar); font-variant-numeric: tabular-nums; min-width: 46px; }
  .sesiones a { color: #fff; font-weight: 500; }
  .sesiones a:hover { color: var(--ambar); }
  .clase-desc { color: #dbe4f3; font-size: 0.92rem; margin-bottom: 10px; }
  .clase-docente { display: flex; align-items: center; gap: 7px; color: #fff; font-size: 0.88rem; font-weight: 500; margin-bottom: var(--sp-2); }
  .clase-cta { margin-top: auto; justify-content: center; width: 100%; }

  /* ---------- Grabaciones y recurso ---------- */
  .poster {
    position: relative; display: block; aspect-ratio: 16 / 9; width: 100%;
    background:
      radial-gradient(circle at 20% 15%, rgba(245, 158, 11, 0.18), transparent 45%),
      linear-gradient(145deg, #1D3A6E 0%, #122a52 100%);
    border: none; padding: 0; cursor: pointer; text-align: left; overflow: hidden; color: #fff;
  }
  .poster::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .poster::after {
    content: 'Δ'; position: absolute; right: -8px; bottom: -48px;
    font-family: var(--fuente-titulo); font-weight: 700; font-size: 9rem; line-height: 1; color: #fff; opacity: 0.06;
  }
  .chip-poster {
    position: absolute; top: 14px; left: 14px; z-index: 1;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    background: rgba(255, 255, 255, 0.14); color: #fff; padding: 4px 10px; border-radius: 999px; backdrop-filter: blur(4px);
  }
  .play {
    position: absolute; top: 42%; left: 50%; transform: translate(-50%, -50%); z-index: 1;
    width: 62px; height: 62px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; padding-left: 4px;
    background: var(--ambar); color: var(--azul);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35), 0 0 0 8px rgba(245, 158, 11, 0.18);
    transition: transform var(--trans), box-shadow var(--trans);
  }
  .poster:hover .play { transform: translate(-50%, -50%) scale(1.08); box-shadow: 0 12px 34px rgba(0, 0, 0, 0.4), 0 0 0 12px rgba(245, 158, 11, 0.2); }
  .poster-titulo {
    position: absolute; left: 16px; right: 16px; bottom: 30px; z-index: 1;
    font-family: var(--fuente-titulo); font-weight: 700; font-size: 1.2rem; line-height: 1.15; color: #fff;
  }
  .poster-meta { position: absolute; left: 16px; bottom: 11px; z-index: 1; font-size: 0.76rem; color: #cbd5e1; }

  .poster-recurso { background: linear-gradient(145deg, #FEF3C7 0%, #FDE68A 100%); color: var(--azul); }
  .poster-recurso::before { background-image: linear-gradient(rgba(29, 58, 110, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(29, 58, 110, 0.06) 1px, transparent 1px); }
  .poster-recurso::after { color: var(--azul); opacity: 0.07; }
  .poster-recurso .poster-titulo { color: var(--azul); }
  .poster-recurso .poster-meta { color: #92400e; }
  .chip-claro { background: rgba(29, 58, 110, 0.1); color: var(--azul); }
  .doc {
    position: absolute; top: 42%; left: 50%; transform: translate(-50%, -50%); z-index: 1;
    width: 62px; height: 62px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
    background: var(--azul); color: var(--ambar); box-shadow: 0 10px 26px rgba(29, 58, 110, 0.3);
  }

  .card-body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex-grow: 1; }
  .card-docente { font-size: 0.8rem; font-weight: 700; color: var(--azul); margin: 0 0 6px; }
  .card-desc { color: var(--texto-suave); font-size: 0.92rem; margin: 0 0 12px; }
  .card-lista { list-style: none; padding: 0; margin: 0 0 var(--sp-2); display: flex; flex-direction: column; gap: 7px; flex-grow: 1; }
  .card-lista li { display: flex; align-items: flex-start; gap: 8px; font-size: 0.86rem; color: var(--texto); line-height: 1.35; }
  .card-lista svg { color: var(--ambar); flex-shrink: 0; margin-top: 2px; }
  .card-acciones { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .btn-chico { padding: 9px 16px; font-size: 0.88rem; }
  .link-materia { font-size: 0.86rem; font-weight: 700; }

  /* ---------- Puntos ---------- */
  .nov-dots { display: flex; justify-content: center; gap: 8px; margin-top: 4px; }
  .nov-dot {
    width: 9px; height: 9px; border-radius: 999px; border: none; padding: 0; cursor: pointer;
    background: #cbd5e1; transition: width var(--trans), background var(--trans);
  }
  .nov-dot[aria-selected='true'] { width: 28px; background: var(--ambar); }

  /* ---------- Modal de video ---------- */
  .nov-modal { border: none; padding: 0; background: transparent; width: min(960px, 94vw); max-width: none; }
  .nov-modal::backdrop { background: rgba(10, 20, 40, 0.82); backdrop-filter: blur(3px); }
  .modal-caja { position: relative; }
  .modal-video { aspect-ratio: 16 / 9; background: #000; border-radius: 14px; overflow: hidden; }
  .modal-video iframe { width: 100%; height: 100%; border: 0; }
  .modal-cerrar {
    position: absolute; top: -44px; right: 0; width: 38px; height: 38px; border-radius: 50%;
    border: none; background: #fff; color: var(--azul); font-size: 1.5rem; line-height: 1; cursor: pointer;
  }

  @media (max-width: 980px) { .nov-track { grid-auto-columns: calc((100% - var(--gap)) / 2); } }
  @media (max-width: 640px) {
    .novedades { padding-top: var(--sp-6); }
    .nov-track { --gap: 14px; grid-auto-columns: 86%; }
    .nov-controles { display: none; }
    .nov-head { margin-bottom: var(--sp-2); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nov-track { scroll-behavior: auto; }
    .punto { animation: none; }
  }
</style>

<script>
  const seccion = document.querySelector('.novedades');
  if (seccion) {
    const track = seccion.querySelector('.nov-track');
    const cards = [...seccion.querySelectorAll('.nov-card')];
    const dots = [...seccion.querySelectorAll('.nov-dot')];
    const flechas = [...seccion.querySelectorAll('.nov-flecha')];
    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Una clase ya dada se muestra como tal aunque el sitio no se haya vuelto a publicar.
    seccion.querySelectorAll('.nov-card[data-fin]').forEach((card) => {
      if (Date.now() <= Date.parse(card.dataset.fin)) return;
      card.querySelector('[data-badge]')?.classList.add('pasada');
      const badge = card.querySelector('[data-badge-texto]');
      if (badge) badge.textContent = 'Ya se dio';
      const cta = card.querySelector('[data-cta]');
      if (cta && card.dataset.hrefPasada) cta.setAttribute('href', card.dataset.hrefPasada);
      const txt = card.querySelector('[data-cta-texto]');
      if (txt) txt.textContent = 'Pedí la grabación';
    });

    const paso = () => (cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth);
    const indice = () => Math.round(track.scrollLeft / paso());
    const irA = (i) => track.scrollTo({ left: Math.max(0, Math.min(i, cards.length - 1)) * paso(), behavior: reducir ? 'auto' : 'smooth' });

    function actualizar() {
      const i = indice();
      dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === i)));
      const alFinal = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
      flechas[0].disabled = track.scrollLeft <= 4;
      flechas[1].disabled = alFinal;
    }
    let pedido = false;
    track.addEventListener('scroll', () => {
      if (pedido) return;
      pedido = true;
      requestAnimationFrame(() => { pedido = false; actualizar(); });
    }, { passive: true });
    window.addEventListener('resize', actualizar, { passive: true });

    flechas.forEach((b) => b.addEventListener('click', () => { detener(); irA(indice() + Number(b.dataset.dir)); }));
    dots.forEach((d) => d.addEventListener('click', () => { detener(); irA(Number(d.dataset.i)); }));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); detener(); irA(indice() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); detener(); irA(indice() - 1); }
    });

    // Autoplay suave: se detiene para siempre en cuanto la persona interactúa.
    let timer = null;
    let pausado = false;
    function detener() { clearInterval(timer); timer = null; }
    function arrancar() {
      if (reducir || timer) return;
      timer = setInterval(() => {
        if (pausado || document.hidden) return;
        const alFinal = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
        irA(alFinal ? 0 : indice() + 1);
      }, 6500);
    }
    ['pointerdown', 'wheel', 'touchstart'].forEach((ev) => track.addEventListener(ev, detener, { passive: true }));
    seccion.addEventListener('mouseenter', () => { pausado = true; });
    seccion.addEventListener('mouseleave', () => { pausado = false; });
    seccion.addEventListener('focusin', () => { pausado = true; });
    new IntersectionObserver(([e]) => { if (e.isIntersecting) arrancar(); else detener(); }, { threshold: 0.4 }).observe(seccion);

    // Modal de video (solo para grabaciones con link publicado)
    const modal = seccion.querySelector('.nov-modal');
    const iframe = modal.querySelector('iframe');
    seccion.querySelectorAll('[data-embed]').forEach((b) => b.addEventListener('click', () => {
      detener();
      iframe.src = b.dataset.embed;
      iframe.title = b.dataset.titulo || 'Grabación de la clase';
      modal.showModal();
    }));
    // Vaciar el iframe al cerrar: si no, el video sigue sonando con el modal oculto.
    const vaciar = () => { iframe.src = 'about:blank'; };
    const cerrar = () => { modal.close(); vaciar(); };
    modal.querySelector('.modal-cerrar').addEventListener('click', cerrar);
    modal.addEventListener('click', (e) => { if (e.target === modal) cerrar(); });
    new MutationObserver(() => { if (!modal.open) vaciar(); }).observe(modal, { attributes: true, attributeFilter: ['open'] });

    actualizar();
  }
</script>
